programa {
  funcao inicio() {
    real largura, comprimento, area_total

    escreva("Digite a largura do galpão (metros): ")
    leia(largura)

    escreva("Digite o comprimento do galpão (metros): ")
    leia(comprimento)

    area_total = largura * comprimento

    escreva("A área total do galpão é: ", area_total, " m²")
  }
}
