programa {
  funcao inicio() {
    inteiro remessa1, remessa2, estoque_total

    escreva("Digite a quantidade de parafusos da primeira remessa: ")
    leia(remessa1)

    escreva("Digite a quantidade de parafusos da segunda remessa: ")
    leia(remessa2)

    estoque_total = remessa1 + remessa2

    escreva("O estoque total disponível de parafusos é: ", estoque_total)
  }
}
